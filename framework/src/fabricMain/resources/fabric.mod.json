{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modVersion}",
  "name": "${modName}",
  "description": "Kotlin New Horizons — a Jetpack Compose runtime for Minecraft mods. And more.",
  "authors": ["fopwoc"],
  "contact": {
    "homepage": "${repositoryUrl}",
    "sources": "${repositoryUrl}",
    "issues": "${issuesUrl}"
  },
  "license": "WTFNMFPL",
  "environment": "*",
  "mixins": ["knhcore.mixins.json"],
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "io.github.fopwoc.mods.framework.FrameworkFabric"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.14",
    "forgeconfigapiport": ">=21.1",
    "minecraft": "${minecraftVersion}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
