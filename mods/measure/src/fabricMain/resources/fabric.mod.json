{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modVersion}",
  "name": "${modName}",
  "description": "A measuring tape: lines, boxes and spheres drawn in the world with their sizes, kept per world and exportable.",
  "authors": ["fopwoc"],
  "contact": {
    "homepage": "${repositoryUrl}",
    "sources": "${repositoryUrl}",
    "issues": "${issuesUrl}"
  },
  "license": "WTFNMFPL",
  "environment": "client",
  "mixins": ["measure.mixins.json"],
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "io.github.fopwoc.mods.gtnhmeasurement.MeasurementFabric"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.14",
    "knhcore": "${modVersion}",
    "minecraft": "${minecraftVersion}"
  }
}
