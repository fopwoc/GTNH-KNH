{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modVersion}",
  "name": "${modName}",
  "description": "A world map that remembers every moment it has seen, to scroll back through like a time-lapse.",
  "authors": ["fopwoc"],
  "contact": {
    "homepage": "${repositoryUrl}",
    "sources": "${repositoryUrl}",
    "issues": "${issuesUrl}"
  },
  "license": "WTFNMFPL",
  "environment": "client",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "io.github.fopwoc.mods.palimpsest.PalimpsestFabric"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19",
    "fabric-language-kotlin": ">=1.14",
    "knhcore": "${modVersion}",
    "minecraft": "${minecraftVersion}"
  }
}
