{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modVersion}",
  "name": "${modName}",
  "description": "Storybook for KNH Core: every component in its states on one screen. A development tool.",
  "authors": ["fopwoc"],
  "contact": {
    "homepage": "${repositoryUrl}",
    "sources": "${repositoryUrl}",
    "issues": "${issuesUrl}"
  },
  "license": "WTFNMFPL",
  "environment": "client",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "io.github.fopwoc.mods.testgui.TestGuiFabric"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19",
    "fabric-language-kotlin": ">=1.14",
    "knhcore": "${modVersion}",
    "minecraft": "${minecraftVersion}"
  }
}
