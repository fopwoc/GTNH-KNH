{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modVersion}",
  "name": "${modName}",
  "description": "Storybook for KNH Core: every framework component in its states, one screen. Development tool, not for packs.",
  "authors": ["fopwoc"],
  "contact": {
    "sources": "https://github.com/fopwoc/GTNH-KNH"
  },
  "license": "WTFPL",
  "environment": "client",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "io.github.fopwoc.mods.testgui.TestGuiFabric"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19",
    "fabric-language-kotlin": ">=1.14",
    "knhcore": "*",
    "minecraft": "${minecraftVersion}"
  }
}
